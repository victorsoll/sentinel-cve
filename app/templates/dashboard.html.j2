    el(svg, 'path', {d:pts.map(function(p,i){ return (i?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1); }).join(' '), fill:'none', stroke:'#fff', 'stroke-width':1.6, opacity:.9});
